rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function professorUid() {
      return 'PROFESSOR_UID_PLACEHOLDER';
    }

    function isProfessor() {
      return request.auth != null && request.auth.uid == professorUid();
    }

    function fotoCadastroValida(foto) {
      return foto is string
        && foto.size() <= 120000
        && foto.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}');
    }

    function cadastroPendenteProprio(userId) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == userId
        && userId != professorUid()
        && d.keys().hasAll(['nome', 'email', 'whatsapp', 'nascimento',
                           'genero', 'perfil', 'ativo', 'professorId', 'criadoEm'])
        && d.keys().hasOnly(['nome', 'email', 'whatsapp', 'nascimento',
                            'genero', 'perfil', 'ativo', 'professorId', 'criadoEm',
                            'fotoCadastro'])
        && (!('fotoCadastro' in d) || fotoCadastroValida(d.fotoCadastro))
        && d.perfil == 'aluno'
        && d.ativo == false
        && d.professorId == professorUid()
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 120
        && d.email is string && d.email.size() <= 254
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && d.email == request.auth.token.email.lower()
        && d.whatsapp is string && d.whatsapp.size() <= 25
        && d.whatsapp.replace('[^0-9]', '').size() >= 10
        && d.whatsapp.replace('[^0-9]', '').size() <= 15
        && d.nascimento is string
        && d.nascimento.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.genero in ['Masculino', 'Feminino', 'Prefiro não informar']
        && d.criadoEm == request.time;
    }

    match /usuarios/{userId} {
      // Preserva a leitura própria e o acesso do professor já existentes.
      allow read: if isProfessor()
        || (request.auth != null && request.auth.uid == userId);
      allow write: if isProfessor();

      // O aluno pode criar apenas sua solicitação, ainda sem aprovação.
      allow create: if cadastroPendenteProprio(userId);

      // Enquanto a solicitação estiver pendente, o aluno só pode alterar a foto.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && userId != professorUid()
        && resource.data.perfil == 'aluno'
        && resource.data.ativo == false
        && resource.data.professorId == professorUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fotoCadastro'])
        && fotoCadastroValida(request.resource.data.fotoCadastro);
    }

    match /usuarios/{studentUid}/treinos/{workoutId} {
      function alunoVinculado() {
        return get(/databases/$(database)/documents/usuarios/$(studentUid)).data;
      }

      function professorDoAluno() {
        return isProfessor()
          && alunoVinculado().perfil == 'aluno'
          && alunoVinculado().professorId == professorUid();
      }

      allow read: if workoutId == 'atual' && request.auth != null
        && (professorDoAluno()
          || (request.auth.uid == studentUid
            && alunoVinculado().perfil == 'aluno'
            && alunoVinculado().ativo == true
            && alunoVinculado().professorId == professorUid()));

      allow create, update: if workoutId == 'atual' && professorDoAluno()
        && alunoVinculado().ativo == true
        && request.resource.data.keys().hasAll(['version', 'professorId',
          'studentId', 'studentUid', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['version', 'professorId',
          'studentId', 'studentUid', 'payload', 'updatedAt'])
        && request.resource.data.version == 2
        && request.resource.data.professorId == professorUid()
        && request.resource.data.studentUid == studentUid
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.payload is string
        && request.resource.data.payload.toUtf8().size() <= 650000
        && request.resource.data.updatedAt == request.time;

      allow delete: if workoutId == 'atual' && professorDoAluno();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}